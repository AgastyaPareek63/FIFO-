`timescale 1ns/1ps

module async_fifo_tb;

    parameter DATA_WIDTH = 8;
    parameter DEPTH = 16;

    reg wr_clk;
    reg rd_clk;
    reg wr_rst;
    reg rd_rst;

    reg wr_en;
    reg rd_en;
    reg [DATA_WIDTH-1:0] din;

    wire [DATA_WIDTH-1:0] dout;
    wire full;
    wire empty;
    wire almost_full;
    wire almost_empty;
    wire prog_full;
    wire prog_empty;
    wire ecc_single_error;
    wire ecc_double_error;


    // DUT
    async_fifo #(
        .DATA_WIDTH(DATA_WIDTH),
        .DEPTH(DEPTH)
    ) dut (
        .wr_clk(wr_clk),
        .wr_rst(wr_rst),
        .wr_en(wr_en),
        .din(din),

        .rd_clk(rd_clk),
        .rd_rst(rd_rst),
        .rd_en(rd_en),
        .dout(dout),

        .full(full),
        .empty(empty),
        .almost_full(almost_full),
        .almost_empty(almost_empty),
        .prog_full(prog_full),
        .prog_empty(prog_empty),

        .ecc_single_error(ecc_single_error),
        .ecc_double_error(ecc_double_error)
    );


    // Write Clock: 10 ns
    initial wr_clk = 0;
    always #5 wr_clk = ~wr_clk;

    // Read Clock: 14 ns
    initial rd_clk = 0;
    always #7 rd_clk = ~rd_clk;


    initial begin

        // Initial values
        wr_rst = 1;
        rd_rst = 1;
        wr_en = 0;
        rd_en = 0;
        din = 0;

        // Reset
        #20;
        wr_rst = 0;
        rd_rst = 0;


        // Write data
        @(negedge wr_clk);
        din = 8'hA5;
        wr_en = 1;

        @(negedge wr_clk);
        din = 8'h3C;

        @(negedge wr_clk);
        din = 8'h55;

        @(negedge wr_clk);
        wr_en = 0;


        // Wait for pointer synchronization
        #50;


        // Read data
        @(negedge rd_clk);
        rd_en = 1;

        @(negedge rd_clk);
        rd_en = 0;

        #20;


        @(negedge rd_clk);
        rd_en = 1;

        @(negedge rd_clk);
        rd_en = 0;

        #20;


        @(negedge rd_clk);
        rd_en = 1;

        @(negedge rd_clk);
        rd_en = 0;

        #30;

        $finish;

    end

endmodule
